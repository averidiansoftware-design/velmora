rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Videos: cada usuario solo puede escribir dentro de su propia
    // carpeta videos/{uid}/, pero cualquiera puede leer (contenido público).
    match /videos/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 100 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Avatares de perfil.
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Cualquier otra ruta: bloqueada por defecto.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
